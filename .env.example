# ==========================================================================
# NUBARI — Variables de entorno
# Copiá este archivo como ".env" y completá los valores reales.
# NUNCA subas el archivo ".env" a un repositorio público.
# ==========================================================================

# URL pública del sitio (usada en SEO/Open Graph y en redirects de pago)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Número de WhatsApp de Nubari, en formato internacional sin "+" ni espacios
# Ejemplo: 5491122334455
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --------------------------------------------------------------------------
# ANDREANI — API oficial
# Solicitar acceso en https://developers.andreani.com
# --------------------------------------------------------------------------
ANDREANI_API_URL=
ANDREANI_API_KEY=
ANDREANI_CLIENTE=
ANDREANI_CONTRATO=

# --------------------------------------------------------------------------
# VÍA CARGO
# El acceso depende del convenio comercial que otorgue Vía Cargo.
# --------------------------------------------------------------------------
VIACARGO_API_URL=
VIACARGO_API_KEY=

# --------------------------------------------------------------------------
# MERCADO PAGO
# Crear una app en https://www.mercadopago.com.ar/developers
# --------------------------------------------------------------------------
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
